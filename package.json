{
  "name": "jothi-matrimony",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "npm --prefix apps/api run dev",
    "build": "npm run build:api",
    "build:api": "npm --prefix apps/api run build",
    "build:web": "npm --prefix apps/web run build",
    "start": "node apps/api/dist/main.js",
    "start:api": "npm --prefix apps/api run start",
    "start:web": "npm --prefix apps/web run start",
    "lint": "oxlint"
  },
  "devDependencies": {
    "oxlint": "^1.81.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.0",
    "axios": "^1.21.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "razorpay": "^2.9.8"
  }
}
